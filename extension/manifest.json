{
  "manifest_version": 3,
  "name": "KnowBefore",
  "version": "0.2.0",
  "description": "KnowBefore reading companion (development build). Requires the app at http://localhost:3000.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open KnowBefore"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "tabs", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["<all_urls>"]
}
