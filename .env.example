# Main AI provider: Luminal's OpenAI-compatible API. Server-only; never prefix with NEXT_PUBLIC_.
LUMINAL_API_KEY=
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Fallback AI provider, used when Luminal is busy or not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used when the main model is overloaded (Gemini returns 503 during demand spikes).
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

MATHPIX_APP_ID=
MATHPIX_APP_KEY=

PDF_PARSER=auto
OCR_PROVIDER=mistral

# Optional: gives OpenAlex searches a dedicated usage budget.
OPENALEX_API_KEY=

# Optional independent review of candidate cross-paper conflicts.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Voice (Track C). Server-only. Without a key, the browser voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_FAST=eleven_flash_v2_5
ELEVENLABS_MODEL_HIGH=eleven_multilingual_v2
